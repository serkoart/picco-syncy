// Signing for Picco Syncy.
//
// Contributors: don't edit this file. Create App/Config/Local.xcconfig (git-ignored) with your own
//   DEVELOPMENT_TEAM = <your team ID>
//   PICCO_BUNDLE_ID = <your.reverse.domain>.PiccoSyncy
// The App Group the app and its Share extension share is derived from both ($(DEVELOPMENT_TEAM).$(PICCO_BUNDLE_ID)).

DEVELOPMENT_TEAM = 33JXZ6WRS4
PICCO_BUNDLE_ID = com.serkoart.PiccoSyncy
PICCO_APP_GROUP = $(DEVELOPMENT_TEAM).$(PICCO_BUNDLE_ID)

#include? "Local.xcconfig"
